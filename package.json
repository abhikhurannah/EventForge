{
  "name": "eventforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch server/worker.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration.test.ts",
    "start:api": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "start:worker": "node --env-file-if-exists=.env --import tsx server/worker.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.1.0",
    "mongoose": "^8.8.3",
    "bullmq": "^5.34.4",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "vite": "^6.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "vitest": "^2.1.8",
    "concurrently": "^9.1.0",
    "tailwindcss": "^3.4.17",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49"
  }
}
